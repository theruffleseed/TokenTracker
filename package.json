{
  "name": "tokentracker",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first multi-provider AI quota, credit, and reset tracker",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "worker": "tsx src/worker/index.ts",
    "worker:once": "tsx src/worker/once.ts",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "cap:sync": "cap sync",
    "cap:add:android": "cap add android",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "@capacitor/core": "7.4.3",
    "@playwright/test": "1.55.0",
    "@tailwindcss/forms": "0.5.10",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prisma": "6.16.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
