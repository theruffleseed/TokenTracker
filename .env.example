# --- Required -------------------------------------------------------------
# PostgreSQL 15+ connection string.
DATABASE_URL="postgresql://tokentracker:tokentracker@localhost:5433/tokentracker?schema=public"

# 32+ byte random secret used to sign/derive session material.
# Generate with: npm run keys:generate
AUTH_SECRET="replace-me-with-openssl-rand-base64-48"

# Base64-encoded 32-byte AES-256-GCM key used to encrypt provider credentials.
# Generate with: npm run keys:generate
CREDENTIAL_ENCRYPTION_KEY="replace-me-with-base64-32-bytes"
# Envelope version stored with each credential. Increment only during a planned
# re-encryption/rotation; see docs/security.md.
CREDENTIAL_ENCRYPTION_KEY_VERSION="1"

# --- App ------------------------------------------------------------------
APP_URL="http://localhost:3000"
# Set to true when served over HTTPS (production).
SESSION_COOKIE_SECURE="false"
# Allow registration of new accounts.
ALLOW_REGISTRATION="true"
# Default scheduled refresh cadence for connected accounts (minutes).
REFRESH_DEFAULT_INTERVAL_MINUTES="30"

# Experimental, community-observed quota routes for OpenCode Go and Command
# Code. They are read-only, but are NOT part of those vendors' public API
# contracts. Keep false unless you have read docs/provider-capability-matrix.md.
ENABLE_EXPERIMENTAL_ADAPTERS="false"

# --- Worker ---------------------------------------------------------------
WORKER_POLL_INTERVAL_MS="15000"
WORKER_CONCURRENCY="2"
# Process a refresh synchronously from the web request in addition to queueing.
INLINE_REFRESH="true"
# Test environments only. Never enable in production.
RATE_LIMIT_DISABLED="false"

# --- Tests ----------------------------------------------------------------
TEST_DATABASE_URL="postgresql://tokentracker:tokentracker@localhost:5433/tokentracker_test?schema=public"
